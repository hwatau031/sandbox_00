# Visual Studio
.vs/                  # Visual Studio のユーザー固有のソリューション設定ディレクトリ (VS 2017 以降)
*.suo                 # Visual Studio のソリューションユーザーオプション (VS 2015 以前)
*.user                # Visual Studio のユーザー設定
*.userosscache
*.sln.docstates

# Build Results
[Dd]ebug/             # デバッグビルドの出力ディレクトリ
[Rr]elease/           # リリースビルドの出力ディレクトリ
[Bb]in/               # バイナリ出力ディレクトリ (Debug/Release 以外の場合)
[Oo]bj/               # オブジェクトファイル出力ディレクトリ

# NuGet
*.nuget.props
*.nuget.targets
packages/             # NuGet パッケージの保存ディレクトリ (Packages.config を使用している場合)
!.gitkeep             # (packages/ディレクトリを残したい場合に使用)

# ReSharper and other JetBrains tools
*.resharper
*.dotSettings
*.DotSettings.user

# Rider
.idea/                # JetBrains Rider のプロジェクト設定ディレクトリ

# Visual Studio Code
.vscode/              # Visual Studio Code のワークスペース設定ディレクトリ

# Test Results
TestResults/
*.trx

# Visual Studio Code Live Share
.vsls/

# Azure Functions
.azurefunctions/

# Editor config
.editorconfig         # プロジェクト全体で共有されるコードスタイル設定ファイル（通常は追跡対象だが、テスト環境によっては無視）
# !.editorconfig      # もし .editorconfig を無視したいが、特定の .editorconfig ファイルは追跡したい場合に使う

# SQL Server Management Studio (SSMS)
*.ssmssln             # SSMS のソリューションファイル
*.sqlproj.user        # SSMS プロジェクトのユーザー設定ファイル

# Database files
*.mdf
*.ldf
*.sdf
*.db

# Temporary files
*.tmp
*.log
*.bak
*~                    # Emacs などで生成されるバックアップファイル

# macOS specific (if you're on a Mac or working with Mac users)
.DS_Store

# Windows specific
Thumbs.db
ehthumbs.db
desktop.ini

# Deployment artifacts
Publish/

# VSIX (Visual Studio Extension)
*.vsix

